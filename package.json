{
  "name": "productkind",
  "version": "0.1.0",
  "description": "productkind monorepo",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "build": "zx ./productkind/scripts/build.ts && zx ./seminars/scripts/build.ts && zx ./kim-and-tim/scripts/build.ts",
    "init": "zx ./productkind/scripts/init.ts",
    "publish:dungarees": "dungarees publish-multi-lib ./dungarees",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "audit-dependencies": "dungarees audit-dependencies ./dungarees",
    "lint": "eslint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/productkind/monorepo.git"
  },
  "author": "info@productkind.com",
  "bugs": {
    "url": "https://github.com/productkind/monorepo/issues"
  },
  "homepage": "https://github.com/productkind/monorepo#readme",
  "license": "SEE LICENSE IN LICENSE.md",
  "dependencies": {
    "@dungarees/cli-bin": "*"
  },
  "workspaces": [
    "dungarees/src/*",
    "dungarees/src/bin/**/",
    "dungarees/e2e/",
    "productkind/scripts/",
    "seminars/scripts/",
    "kim-and-tim/scripts/"
  ],
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "eslint": "^9.39.5",
    "eslint-config-love": "^155.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.4"
  }
}
