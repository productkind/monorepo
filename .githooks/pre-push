#!/usr/bin/env bash
# Blocks a push that adds a package the npm registry has never seen.
#
# Trusted publishing cannot create a package: npm only accepts an OIDC publish for a name that
# already exists and already has a trusted publisher configured. CI therefore refuses to publish a
# new name, and on a trunk-based repo the push is the last point before that refusal is a red main.
#
# Deciding which manifests count, reading them as they will be pushed, asking the registry and
# reporting it all belongs to `dungarees check-new-packages`, where it is tested.
set -euo pipefail

if [ "${SKIP_BOOTSTRAP_CHECK:-}" = '1' ]; then
  exit 0
fi

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

dungarees=node_modules/.bin/dungarees
if [ ! -x "$dungarees" ]; then
  echo "pre-push: $dungarees not found, skipping the new-package check. Run 'npm ci' to enable it." >&2
  exit 0
fi

ZERO=$(git hash-object --stdin </dev/null | tr '[:xdigit:]' '0')
EMPTY_TREE=$(git hash-object -t tree /dev/null)

found_new_package=0

while read -r _local_ref local_oid _remote_ref remote_oid; do
  # A branch being deleted pushes no commits to look at.
  [ "$local_oid" = "$ZERO" ] && continue

  if [ "$remote_oid" = "$ZERO" ]; then
    # Nothing of this ref is on the remote yet.
    base=$(git merge-base "$local_oid" origin/HEAD 2>/dev/null || echo "$EMPTY_TREE")
  else
    base=$remote_oid
  fi

  # Most pushes here touch marketing content and never go near the library, and skipping the
  # sweep for those keeps a hook that runs on every push from being felt.
  if ! git diff --name-only "$base" "$local_oid" | grep -q '^dungarees/'; then
    continue
  fi

  # The whole library, not just what this push added: a package can have sat unpublished since
  # long before this range, and CI will refuse it just the same.
  # The loop body runs in this shell, so the flag survives to the end.
  "$dungarees" check-new-packages ./dungarees \
    --bootstrap-command 'npm run bootstrap:lib --' || found_new_package=1
done

if [ "$found_new_package" = 1 ]; then
  echo "Bootstrap them all with: npm run bootstrap:missing" >&2
  echo "To push anyway: SKIP_BOOTSTRAP_CHECK=1 git push" >&2
  exit 1
fi
