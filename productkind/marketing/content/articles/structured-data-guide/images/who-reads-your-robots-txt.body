  <rect x="752" y="378" width="222" height="38" fill="#fdd825"/>
  <text x="863" y="402" text-anchor="middle" class="pill">TRAINING CRAWLERS</text>
  <text x="752" y="458" class="body">Your choice. Blocking these doesn't remove you</text>
  <text x="752" y="486" class="body">from search answers.</text>
  <text x="752" y="548" class="code" font-weight="700" font-size="19">GPTBot</text>
  <text x="990" y="548" class="small" style="fill:#080809">OpenAI's AI models</text>
  <line x1="752" y1="570" x2="1308" y2="570" class="divider"/>
  <text x="752" y="602" class="code" font-weight="700" font-size="19">ClaudeBot</text>
  <text x="990" y="602" class="small" style="fill:#080809">Anthropic's AI models</text>
  <line x1="752" y1="624" x2="1308" y2="624" class="divider"/>
  <text x="752" y="656" class="code" font-weight="700" font-size="19">Google-Extended</text>
  <text x="990" y="656" class="small" style="fill:#080809">Google's Gemini</text>
  <rect x="752" y="742" width="556" height="76" fill="#ffffff" stroke="#fdd825" stroke-width="2"/>
  <text x="776" y="776" class="small" style="fill:#080809">Google says blocking Google-Extended doesn't</text>
  <text x="776" y="802" class="small" style="fill:#080809">affect Google Search.</text>

  <rect x="60" y="890" width="1280" height="110" fill="#1a0044"/>
  <rect x="60" y="890" width="14" height="110" fill="url(#brand-gradient-v)"/>
