  <text x="92" y="458" class="body">Let these in, so your website can appear in</text>
  <text x="92" y="486" class="body">search results and AI answers.</text>
  <text x="92" y="548" class="code" font-weight="700" font-size="19">Googlebot</text>
  <text x="330" y="548" class="small" style="fill:#080809">Google Search, AI Overviews, AI Mode</text>
  <line x1="92" y1="570" x2="648" y2="570" class="divider"/>
  <text x="92" y="602" class="code" font-weight="700" font-size="19">Bingbot</text>
  <text x="330" y="602" class="small" style="fill:#080809">Bing and Microsoft Copilot</text>
  <line x1="92" y1="624" x2="648" y2="624" class="divider"/>
  <text x="92" y="656" class="code" font-weight="700" font-size="19">OAI-SearchBot</text>
  <text x="330" y="656" class="small" style="fill:#080809">ChatGPT search</text>
  <line x1="92" y1="678" x2="648" y2="678" class="divider"/>
  <text x="92" y="710" class="code" font-weight="700" font-size="19">Claude-SearchBot</text>
  <text x="330" y="710" class="small" style="fill:#080809">Claude search</text>
  <line x1="92" y1="732" x2="648" y2="732" class="divider"/>
  <text x="92" y="764" class="code" font-weight="700" font-size="19">Claude-User</text>
  <text x="330" y="764" class="small" style="fill:#080809">Claude, on-demand user fetch</text>
  <line x1="92" y1="786" x2="648" y2="786" class="divider"/>
  <text x="92" y="818" class="code" font-weight="700" font-size="19">PerplexityBot</text>
  <text x="330" y="818" class="small" style="fill:#080809">Perplexity</text>

  <g filter="url(#card-shadow)">
    <rect x="720" y="340" width="620" height="510" fill="#fff8d9" stroke="#fdd825" stroke-width="3"/>
