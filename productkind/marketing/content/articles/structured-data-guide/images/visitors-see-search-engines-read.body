W=1400 H=920
TITLE=What visitors see, and what search engines read
DESC=One of our own Little Parrot course pages, Build Your First App with Lovable, while the course was free for a limited time. On the left, what visitors see: the course title, a label saying Free until 18 October, a Start Learning button, and no author names anywhere on the page. On the right, the schema markup search engines read from the same page, shortened. The course name matches the page. The offer says a price of 24 euros, while the page says the course is free. The author list names Kinga Magyar and Tamas Kokeny, who are not named on the page. This is valid Schema.org, so a validator passes it. The planning prompt catches it, because it compares every fact in the markup with the page.
---
  <text x="50" y="84" class="display" font-size="36" font-weight="700">What visitors see, and what search engines read</text>
  <text x="50" y="124" class="copy muted" font-size="22">One of our own course pages, while the course was free for a limited time.</text>

  <!-- Left: the page -->
  <text x="60" y="186" class="mini">WHAT VISITORS SEE</text>
  <g filter="url(#card-shadow)">
    <rect x="60" y="204" width="540" height="500" fill="#ffffff" stroke="#080809" stroke-width="3"/>
  </g>
  <rect x="60" y="204" width="540" height="44" fill="#f4f3ef" stroke="#080809" stroke-width="3"/>
  <circle cx="86" cy="226" r="6" fill="#ffb65b"/>
  <circle cx="106" cy="226" r="6" fill="#fdd825"/>
  <circle cx="126" cy="226" r="6" fill="#00ed70"/>
  <text x="150" y="232" class="small" font-size="16">littleparrot.app/…/course-overview</text>
  <text x="96" y="312" class="display" font-size="32" font-weight="700">Build Your First App</text>
  <text x="96" y="356" class="display" font-size="32" font-weight="700">with Lovable</text>
  <rect x="96" y="386" width="246" height="40" fill="#94ffad" stroke="#080809" stroke-width="2"/>
  <text x="219" y="412" text-anchor="middle" class="pill">FREE UNTIL 18 OCTOBER</text>
  <rect x="96" y="456" width="460" height="12" fill="#e6e5df"/>
  <rect x="96" y="482" width="430" height="12" fill="#e6e5df"/>
  <rect x="96" y="508" width="380" height="12" fill="#e6e5df"/>
  <rect x="96" y="546" width="190" height="48" fill="#080809"/>
  <text x="191" y="577" text-anchor="middle" class="copy" font-size="18" font-weight="700" style="fill:#ffffff">Start Learning</text>
  <rect x="96" y="622" width="460" height="52" fill="none" stroke="#ffb65b" stroke-width="3" stroke-dasharray="10 8"/>
  <text x="116" y="655" class="small" style="fill:#080809">No author names anywhere on the page</text>

  <!-- Right: the markup -->
  <text x="660" y="186" class="mini">WHAT SEARCH ENGINES READ (SHORTENED)</text>
  <g filter="url(#card-shadow)">
    <rect x="660" y="204" width="680" height="500" fill="#f4f3ef" stroke="#080809" stroke-width="3"/>
  </g>
  <rect x="676" y="296" width="648" height="40" fill="#eafff4"/>
  <rect x="676" y="344" width="648" height="124" fill="#fff3e6"/>
  <rect x="676" y="476" width="648" height="160" fill="#fff3e6"/>
  <text x="692" y="256" class="code" xml:space="preserve">"@type": "Course",</text>
  <text x="692" y="322" class="code" xml:space="preserve">"name": "Build Your First App With Lovable",</text>
  <text x="692" y="372" class="code" xml:space="preserve">"offers": {</text>
  <text x="692" y="404" class="code" xml:space="preserve">  "price": "24",</text>
  <text x="692" y="436" class="code" xml:space="preserve">  "priceCurrency": "EUR"</text>
  <text x="692" y="460" class="code" xml:space="preserve">},</text>
  <text x="692" y="504" class="code" xml:space="preserve">"author": [</text>
  <text x="692" y="536" class="code" xml:space="preserve">  "Kinga Magyar",</text>
  <text x="692" y="568" class="code" xml:space="preserve">  "Tamas Kokeny"</text>
  <text x="692" y="600" class="code" xml:space="preserve">]</text>
  <rect x="1152" y="350" width="160" height="34" fill="#ffb65b"/>
  <text x="1232" y="373" text-anchor="middle" class="pill" font-size="14">PAGE SAYS FREE</text>
  <rect x="1172" y="482" width="140" height="34" fill="#ffb65b"/>
  <text x="1242" y="505" text-anchor="middle" class="pill" font-size="14">NOT ON PAGE</text>
  <rect x="1192" y="302" width="120" height="28" fill="#00ed70"/>
  <text x="1252" y="322" text-anchor="middle" class="pill" font-size="14">MATCHES</text>

  <rect x="60" y="744" width="1280" height="110" fill="#1a0044"/>
  <rect x="60" y="744" width="14" height="110" fill="url(#brand-gradient-v)"/>
  <text x="104" y="784" class="display" font-size="20" font-weight="700" style="fill:#ffd79a">VALID SCHEMA.ORG, WRONG FACTS</text>
  <text x="104" y="818" class="copy" font-size="21" style="fill:#ffffff">A validator passes this markup. The planning prompt catches it, because it compares every fact with the page.</text>
  <text x="1340" y="895" text-anchor="end" class="label">LittleParrot.app</text>
